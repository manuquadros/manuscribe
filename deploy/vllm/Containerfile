# Unified image: the vLLM server (GPU + torch 2.11) and the manuscribe client in
# one container. vLLM owns torch/transformers; manuscribe carries neither, so
# there is no version conflict to resolve — it just talks to 127.0.0.1:8000.
#
# Build:  podman build -f deploy/vllm/Containerfile -t lighton-manuscribe .
# (build context is the repo root so the COPYs see src/ and pyproject.toml)
#
# On an arm64 host (GB10) override VLLM_IMAGE, not just the tag: the default
# repo may publish no arm64 build. See README.md's GB10 section.
ARG VLLM_IMAGE=docker.io/vllm/vllm-openai
ARG VLLM_TAG=v0.22.1
FROM ${VLLM_IMAGE}:${VLLM_TAG}

# Freeze the base image's already-installed packages as a constraint file, then
# let pip resolve manuscribe's own deps from pyproject.toml against it: anything
# manuscribe needs that the base already ships (torch/transformers/numpy/...) is
# pinned to the base's version instead of upgraded, and anything manuscribe
# declares that the base lacks is installed normally. This tracks
# pyproject.toml's dependency list automatically instead of a hand-copied
# subset that drifts.
RUN pip freeze --all > /tmp/base-constraints.txt
COPY pyproject.toml README.md /opt/manuscribe/
COPY src /opt/manuscribe/src
RUN pip install --no-cache-dir --constraint /tmp/base-constraints.txt /opt/manuscribe \
    && rm /tmp/base-constraints.txt
RUN python3 -c "import manuscribe.pipeline"

# Flashinfer JIT sampler needs nvcc (absent here); fall back to the Torch sampler.
ENV VLLM_USE_FLASHINFER_SAMPLER=0 \
    MANUSCRIBE_VLLM_URL=http://127.0.0.1:8000/v1 \
    MANUSCRIBE_VLLM_MODEL=lightonocr

# The dtype and the attention backend depend on the card, which is invisible at
# build time, so the entrypoint resolves them per container start (see
# gpu-defaults.sh) before exec'ing the base image's `vllm serve`.
COPY deploy/vllm/gpu-defaults.sh deploy/vllm/entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/gpu-defaults.sh /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Arguments for `vllm serve`, tuned for the 6 GiB card (see
# spike_results/vllm_determinism.md).  --dtype is deliberately absent: the
# entrypoint supplies the one the card supports, and an explicit --dtype appended
# here or on `podman run` overrides it. Running the image starts the warm server;
# convert PDFs against it with `podman exec`:
#   podman exec <name> python3 -m manuscribe /data/in.pdf /data/out.html
CMD ["lightonai/LightOnOCR-2-1B-bbox", \
     "--served-model-name", "lightonocr", \
     "--gpu-memory-utilization", "0.85", \
     "--max-model-len", "8192", \
     "--limit-mm-per-prompt", "{\"image\": 1}", \
     "--enforce-eager"]
